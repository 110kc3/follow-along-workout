{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schema.follow-along-workout.local/workout.schema.json",
  "title": "WorkoutVideoPayload",
  "description": "Per-video payload for vertical short-form workout generation",
  "type": "object",
  "required": [
    "title",
    "hook",
    "template",
    "exercises",
    "rest",
    "caption",
    "hashtags",
    "cta",
    "music_id",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the video/workout generation"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "hook": {
      "type": "string",
      "description": "First 3-second hook text displayed on screen",
      "minLength": 3,
      "maxLength": 120
    },
    "template": {
      "type": "string",
      "enum": ["quick-burn", "emom", "mobility-reset"],
      "description": "Target Remotion composition template"
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "seconds"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "seconds": {
            "type": "integer",
            "minimum": 5,
            "maximum": 120
          },
          "reps": {
            "type": ["integer", "string"]
          },
          "cue": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "rest": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60,
      "description": "Rest interval in seconds between movements or rounds"
    },
    "caption": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2200
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^#[A-Za-z0-9_]+$"
      },
      "minItems": 1
    },
    "cta": {
      "type": "string",
      "description": "Call to action on end card",
      "minLength": 3,
      "maxLength": 80
    },
    "music_id": {
      "type": "string",
      "description": "Identifier of YouTube Audio Library track in render/assets"
    },
    "status": {
      "type": "string",
      "enum": ["idea", "scripted", "rendered", "approved", "posted", "failed"]
    }
  },
  "additionalProperties": false
}
